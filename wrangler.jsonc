{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tools-kits",
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      ".git",
      ".git/**",
      ".github",
      ".github/**",
      "log.md"
    ],
    "not_found_handling": "404-page"
  }
}
